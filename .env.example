# Square credentials (Square Developer Dashboard > your app).
# Leave these empty to run in preview mode with a sample menu and no payments.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "sandbox" for testing with fake cards, "production" for real orders.
SQUARE_ENVIRONMENT=sandbox
# Application ID, used by the card form in the browser.
NEXT_PUBLIC_SQUARE_APP_ID=
